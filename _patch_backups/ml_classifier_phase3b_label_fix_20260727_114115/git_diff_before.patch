+  const params = new URLSearchParams({
+    limit: String(limit),
+  });
+
+  return request(`/certificate-filing/candidates?${params.toString()}`);
+}
+
+export function previewCertificateFiling({
+  ocr_job_id,
+  pmf_row_pos,
+  pmf_depth = 0,
+} = {}) {
+  return request("/certificate-filing/preview", {
+    method: "POST",
+    body: JSON.stringify({
+      ocr_job_id,
+      pmf_row_pos,
+      pmf_depth,
+    }),
+  });
+}
+
