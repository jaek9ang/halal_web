# backend 환경변수 예시. 복사해서 `.env`로 쓰거나 셸에서 export 한다.
# Windows에서는 scripts/local_env.ps1.example 쪽을 쓴다.

# --- PMF / 서류 경로 ---
# 미설정 시 운영 공유폴더(UNC)를 본다. 개발 PC에서는 로컬 테스트 폴더를 지정한다.
PMF_SOURCE_DIR=
HALAL_DOC_ROOT=
HALAL_RAW_MATERIAL_ROOT=

# 공유폴더에 붙지 못할 때 쓰는 대체 저장소.
# 미설정 시 Windows는 D:\halal_web_runtime\원재료, 그 외 OS는 .local_runtime/원재료.
HALAL_LOCAL_RAW_MATERIAL_ROOT=

# --- 메일 계정 (Daum) ---
# 과거 이름 20여 종을 계속 지원하지만, 새로 설정한다면 이 둘만 쓰면 된다.
# app/core/mail_credentials.py 참고.
DAUM_EMAIL=
DAUM_APP_PASSWORD=

# --- AI 규칙 리뷰 ---
OPENAI_API_KEY=
OPENAI_RULE_REVIEW_MODEL=

# --- OCR 엔진 ---
# Tesseract가 PATH에 없을 때만 지정한다.
TESSERACT_CMD=
TESSDATA_PREFIX=

# --- CORS ---
# 쉼표로 구분. 미설정 시 http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
