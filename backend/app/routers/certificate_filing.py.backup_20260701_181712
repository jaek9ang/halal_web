from __future__ import annotations

from fastapi import APIRouter, HTTPException, Query
from pydantic import BaseModel, Field

from app.services.certificate_filing_workflow_service import (
    confirm_filing_workflow,
    ensure_filing_tables,
    list_filing_candidates,
    list_filing_history,
    preview_filing_workflow,
)
from app.services.filing_name_service import get_halal_raw_material_root
from app.services.pmf_filing_service import resolve_pmf_update_path


router = APIRouter()


class FilingPreviewRequest(BaseModel):
    ocr_job_id: int
    pmf_row_pos: int
    pmf_depth: int = Field(default=0, ge=0, le=4)


class FilingConfirmRequest(FilingPreviewRequest):
    overwrite: bool = False
    force: bool = False
    allow_date_regression: bool = False
    change_action: str = ""



@router.get("/status")
def filing_status():
    ensure_filing_tables()
    root = get_halal_raw_material_root()
    pmf_path = resolve_pmf_update_path()

    return {
        "ok": True,
        "filing_root": str(root),
        "filing_root_exists": root.exists(),
        "pmf_update_path": str(pmf_path),
        "pmf_update_path_exists": pmf_path.exists(),
        "mode": "LOCAL_TEST" if str(root).lower().startswith("c:\\temp") else "SHARED_FOLDER",
    }


@router.get("/candidates")
def filing_candidates(limit: int = Query(100, ge=1, le=500)):
    try:
        return list_filing_candidates(limit=limit)
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc)) from exc


@router.post("/preview")
def filing_preview(payload: FilingPreviewRequest):
    try:
        return preview_filing_workflow(
            ocr_job_id=payload.ocr_job_id,
            pmf_row_pos=payload.pmf_row_pos,
            pmf_depth=payload.pmf_depth,
        )
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    except FileNotFoundError as exc:
        raise HTTPException(status_code=404, detail=str(exc)) from exc
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc)) from exc


@router.post("/confirm")
def filing_confirm(payload: FilingConfirmRequest):
    try:
        return confirm_filing_workflow(
            ocr_job_id=payload.ocr_job_id,
            pmf_row_pos=payload.pmf_row_pos,
            pmf_depth=payload.pmf_depth,
            overwrite=payload.overwrite,
            force=payload.force,
            allow_date_regression=(
                payload.allow_date_regression
            ),
            change_action=payload.change_action,
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc),
        ) from exc

    except FileExistsError as exc:
        raise HTTPException(
            status_code=409,
            detail=str(exc),
        ) from exc

    except FileNotFoundError as exc:
        raise HTTPException(
            status_code=404,
            detail=str(exc),
        ) from exc

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        ) from exc



@router.get("/history")
def filing_history(limit: int = Query(100, ge=1, le=500)):
    try:
        return list_filing_history(limit=limit)
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc)) from exc
