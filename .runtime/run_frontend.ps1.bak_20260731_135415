#requires -Version 5.1
$ErrorActionPreference = 'Stop'

Set-Location -LiteralPath 'C:\Users\user\OneDrive\바탕 화면\한재광\회사SW\DT준전문가교육\DLAB\SW Project\halal_web\frontend'

$env:VITE_API_BASE_URL = 'http://127.0.0.1:8000'
$env:VITE_API_URL = 'http://127.0.0.1:8000'

Write-Host ''
Write-Host '할랄인증관리 프론트엔드 실행' -ForegroundColor Cyan
Write-Host '주소: http://127.0.0.1:5173'
Write-Host ''

if (-not (Test-Path -LiteralPath '.\node_modules')) {
    Write-Host 'node_modules가 없어 npm install을 실행합니다.' -ForegroundColor Yellow

    & 'C:\Program Files\nodejs\npm.cmd' install

    if ($LASTEXITCODE -ne 0) {
        throw "npm install 실패. 종료 코드: $LASTEXITCODE"
    }
}

& 'C:\Program Files\nodejs\npm.cmd' 
    run dev 
    -- 
    --host 127.0.0.1 
    --port 5173 
    --strictPort

if ($LASTEXITCODE -ne 0) {
    Write-Host ''
    Write-Host "프론트엔드 종료 코드: $LASTEXITCODE" -ForegroundColor Red
    Read-Host 'Enter를 누르면 창이 닫힙니다'
}