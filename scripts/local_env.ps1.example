# 이 파일을 local_env.ps1로 복사해서 사용한다.
# local_env.ps1은 .gitignore에 포함되어 Git에 기록되지 않는다.

$env:HALAL_RAW_MATERIAL_ROOT = 'C:\TEMP\halal_filing_test'
$env:HALAL_DOC_ROOT = 'C:\TEMP\halal_filing_test'
$env:PMF_SOURCE_DIR = 'C:\TEMP\halal_pmf_source'
$env:MAIL_INBOX_DOWNLOAD_DIR = Join-Path $ProjectRoot 'backend\data\mail_downloads'

$env:TESSERACT_CMD = 'C:\Program Files\Tesseract-OCR\tesseract.exe'
$env:TESSDATA_PREFIX = 'C:\Program Files\Tesseract-OCR\tessdata'

$env:OPENAI_RULE_REVIEW_MODEL = 'gpt-4.1'
# OPENAI_API_KEY는 이 파일에 직접 넣거나 사용자 환경변수로 별도 설정할 수 있다.
# $env:OPENAI_API_KEY = '...'
